# ---------------------------------------------------------------- speaking

def say(text=""):
    """One write per thing said. Flushed, so nothing arrives out of order."""
    sys.stdout.write(text + "\n")
    sys.stdout.flush()


def spoken_duration(seconds):
    try:
        seconds = int(round(float(seconds)))
    except (TypeError, ValueError):
        return None
    if seconds <= 0:
        return None
    hours, rest = divmod(seconds, 3600)
    minutes, secs = divmod(rest, 60)
    parts = []
    if hours:
        parts.append("%d hour%s" % (hours, "" if hours == 1 else "s"))
    if minutes:
        parts.append("%d minute%s" % (minutes, "" if minutes == 1 else "s"))
    if secs and not hours:
        parts.append("%d second%s" % (secs, "" if secs == 1 else "s"))
    return " ".join(parts) if parts else "%d seconds" % seconds


def spoken_size(num_bytes):
    try:
        num_bytes = float(num_bytes)
    except (TypeError, ValueError):
        return None
    if num_bytes <= 0:
        return None
    for unit, cutoff in (("GB", 1024 ** 3), ("MB", 1024 ** 2), ("KB", 1024)):
        if num_bytes >= cutoff:
            value = num_bytes / cutoff
            return "%.1f %s" % (value, unit) if value < 10 else "%d %s" % (round(value), unit)
    return "%d bytes" % int(num_bytes)


# ---------------------------------------------------------------- your defaults

def load_config():
    try:
        with open(CONFIG) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_config(cfg):
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG, "w") as fh:
            json.dump(cfg, fh, indent=2)
        return True
    except OSError as exc:
        say("Could not save your settings: %s" % exc)
        return False


def do_set_default(value, to):
    cfg = load_config()
    if value:
        if value not in FORMATS:
            sys.exit("Not a format I know: %s\nPick one of: %s"
                     % (value, ", ".join(FORMATS)))
        cfg["format"] = value
    if to:
        cfg["to"] = os.path.abspath(os.path.expanduser(to))
    if not save_config(cfg):
        return
    say("Saved. From now on:")
    say("  format:      %s" % cfg.get("format", "best (unchanged)"))
    say("  destination: %s" % pretty_path(cfg.get("to", DEST)))
    say()
    say("Flags still win for a single run. Settings live in %s"
        % pretty_path(CONFIG))


BOOL_KEYS = ("notify", "progress", "auto_update")
TRUTHY = ("yes", "true", "on", "1")
FALSY = ("no", "false", "off", "0")


def do_set_pairs(pairs):
    """Set settings without the questions — what the app drives, and scripts."""
    cfg = load_config()
    for pair in pairs:
        if "=" not in pair:
            sys.exit("Use KEY=VALUE, for example:  ytdl --set notify=yes")
        key, _, raw = pair.partition("=")
        key, raw = key.strip(), raw.strip()
        known = [k for k, _ in SETTINGS]
        if key not in known:
            sys.exit("Not a setting: %s\nThe settings are: %s"
                     % (key, ", ".join(known)))
        if key in BOOL_KEYS:
            if raw.lower() in TRUTHY:
                cfg[key] = True
            elif raw.lower() in FALSY:
                cfg[key] = False
            else:
                sys.exit("%s wants yes or no, not %r" % (key, raw))
        elif key == "format":
            if raw not in FORMATS:
                sys.exit("Not a format: %s\nPick one of: %s" % (raw, ", ".join(FORMATS)))
            cfg[key] = raw
        elif key == "to":
            cfg[key] = os.path.abspath(os.path.expanduser(raw))
        elif key == "max_height":
            cfg[key] = int(raw) if raw.isdigit() and int(raw) > 0 else None
        elif key == "cookies":
            cfg[key] = raw or None
    if save_config(cfg):
        show_settings(load_config())


def pretty_path(path):
    """A path as you would say it, not as it is stored."""
    if not path:
        return "(unset)"
    icloud = os.path.join(HOME, "Library", "Mobile Documents", "com~apple~CloudDocs")
    if path.startswith(icloud):
        rest = path[len(icloud):].strip("/")
        return "iCloud Drive / %s" % rest if rest else "iCloud Drive"
    return path.replace(HOME, "~")


def setting(cfg, key, fallback):
    value = cfg.get(key)
    return fallback if value is None else value


def yes_no(value):
    return "yes" if value else "no"


# The settings, in the order --setup walks through them. Keeping the questions
# and their defaults in one table means --setup and --settings can never drift
# apart, which is the usual way a settings screen starts lying.
SETTINGS = [
