    except (OSError, subprocess.TimeoutExpired):
        return None
    text = (out.stdout or "").strip()
    return text.split()[0] if text else None


def check_url(url):
    """Validated before anything is run, so a bad paste fails as a sentence."""
    if not url:
        sys.exit("No URL given, and nothing on the clipboard.\n"
                 "Copy a link and run ytdl again, or pass one:  ytdl <url>")
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in ("http", "https") or not parsed.netloc:
        sys.exit("That does not look like a web address:\n  %s\n"
                 "Copy the link itself, not the page title." % url[:200])
    return url


def in_a_playlist(url, info=None):
    """Is there a whole set behind this link?

    Two signals, because neither covers everything. YouTube collapses a list
    to one video when --no-playlist is passed, so the metadata comes back
    looking single and only the `list=` parameter gives it away. Every other
    site — Bandcamp albums, SoundCloud sets, BBC series — says so in the
    metadata instead. Keying only on `list=` made this a YouTube-only guard.
    """
    query = urllib.parse.parse_qs(urllib.parse.urlparse(url).query)
    if query.get("list"):
        return True
    if info and (info.get("_type") == "playlist" or info.get("entries")):
        return True
    return False


def site_of(info, url):
    """Which extractor handled this, for wording that is not YouTube-specific."""
    name = (info or {}).get("extractor_key") or (info or {}).get("extractor")
    if name and name.lower() not in ("generic",):
        return name
    host = urllib.parse.urlparse(url).netloc
    return host[4:] if host.startswith("www.") else (host or "the site")


def playlist_size(url):
    """Count without fetching the entries. Best effort — None is fine."""
    try:
        out = subprocess.run(
            [yt_dlp_path(), "--flat-playlist", "--playlist-items", "0",
             "--no-warnings", "-J", url],
            capture_output=True, text=True, timeout=45)
        if out.returncode != 0:
            return None
        return json.loads(out.stdout).get("playlist_count")
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None


def selector(args):
    """The format selector, shared by --info, --pick and the download itself.

    Every path uses this so --info can never describe a different stream from
    the one that would actually arrive.
    """
    if getattr(args, "format_id", None):
        return ["-f", args.format_id]
    if args.kind == "video":
        cap = getattr(args, "max_height", None)
        if cap:
            return ["-f", "bv*[height<=%d][ext=mp4]+ba[ext=m4a]/"
                          "bv*[height<=%d]+ba/b[height<=%d]/b" % (cap, cap, cap)]
        return ["-f", "bv*[ext=mp4]+ba[ext=m4a]/bv*+ba/b"]
    if args.kind == "m4a":
        # Prefer the AAC stream so no transcode is needed to land as .m4a.
        return ["-f", "bestaudio[ext=m4a]/bestaudio"]
    if args.kind == "opus":
        return ["-f", "bestaudio[acodec=opus]/bestaudio"]
    return ["-f", "bestaudio"]


def describe_format(fmt):
    """One plain sentence for a format, the way you would say it out loud."""
    acodec, vcodec = fmt.get("acodec"), fmt.get("vcodec")
    has_audio = acodec and acodec != "none"
    has_video = vcodec and vcodec != "none"
    size = spoken_size(fmt.get("filesize") or fmt.get("filesize_approx"))

    if has_video and has_audio:
        what = "Video %sp with sound, %s" % (fmt.get("height") or "?", vcodec)
    elif has_video:
        what = "Video %sp, %s (sound merged in separately)" % (
            fmt.get("height") or "?", vcodec)
    else:
        abr = fmt.get("abr")
        what = "Audio, %s%s" % (acodec, ", %d kbps" % round(abr) if abr else "")
    return "%s%s" % (what, ", about %s" % size if size else "")


def choosable(info):
    """Formats worth offering: best audio per codec, and one per resolution.

    yt-dlp reports upwards of forty formats for a normal video. Reading forty
    near-identical lines aloud is useless, so this collapses them to the ones
    that represent a real choice.
    """
    best_audio, best_video = {}, {}
    for fmt in info.get("formats") or []:
        acodec, vcodec = fmt.get("acodec"), fmt.get("vcodec")
        if fmt.get("format_note") == "storyboard" or fmt.get("ext") == "mhtml":
            continue
        if vcodec and vcodec != "none":
            key = fmt.get("height") or 0
            if key and (key not in best_video or
                        (fmt.get("tbr") or 0) > (best_video[key].get("tbr") or 0)):
                best_video[key] = fmt
        elif acodec and acodec != "none":
            key = acodec.split(".")[0]
            if key not in best_audio or (fmt.get("abr") or 0) > (best_audio[key].get("abr") or 0):
                best_audio[key] = fmt

    audio = sorted(best_audio.values(), key=lambda f: -(f.get("abr") or 0))
    video = sorted(best_video.values(), key=lambda f: -(f.get("height") or 0))
    return audio + video


def do_list_formats(info, interactive):
    """List the real choices. Returns a chosen format id, or None."""
    options = choosable(info)
    if not options:
        say("yt-dlp reported no usable formats for that one.")
        return None

    say("%d choice%s:" % (len(options), "" if len(options) == 1 else "s"))
    say()
    for i, fmt in enumerate(options, 1):
        say("%2d. %s" % (i, describe_format(fmt)))
    say()

    if not interactive:
        say("Download one with:  ytdl <url> --format-id <id>")
        say("Ids, in the same order: %s"
            % ", ".join(str(f.get("format_id")) for f in options))
        return None

    if not sys.stdin.isatty():
        say("--pick needs a terminal to ask you in. Use --list-formats instead.")
        return None

    try:
        answer = input("Number to download (Enter to cancel): ").strip()
    except (EOFError, KeyboardInterrupt):
        say()
        return None
    if not answer:
        return None
    if not answer.isdigit() or not 1 <= int(answer) <= len(options):
        say("Pick a number from 1 to %d." % len(options))
        return None

    chosen = options[int(answer) - 1]
    say("Chose: %s" % describe_format(chosen))
    # A video-only stream needs audio merged in, or you get a silent file.
    vcodec = chosen.get("vcodec")
    if vcodec and vcodec != "none" and (chosen.get("acodec") in (None, "none")):
        return "%s+bestaudio/%s" % (chosen.get("format_id"), chosen.get("format_id"))
    return str(chosen.get("format_id"))


def fetch_info(url, cookies, fmt=None, flat=False):
    """Metadata for one video, or a flat listing for a playlist.

    `flat` matters more than it looks. Without it, -J on a playlist extracts
    every entry in full — for a channel's uploads that is hundreds of round
    trips and it simply times out. --flat-playlist returns the list and its
    titles in one request and leaves per-video extraction to the download.
    """
    cmd = [yt_dlp_path(), "-J", "--no-warnings"]
    if flat:
        cmd += ["--yes-playlist", "--flat-playlist"]
    else:
        cmd.append("--no-playlist")
        cmd += fmt or []
    if cookies:
        cmd += ["--cookies-from-browser", cookies]
    cmd.append(url)
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
    except (OSError, subprocess.TimeoutExpired):
        return None, "Could not reach that URL — it timed out."
    if out.returncode != 0:
        return None, out.stderr.strip()
    try:
        return json.loads(out.stdout), None
    except ValueError:
        return None, "yt-dlp returned something that was not readable."


# ---------------------------------------------------------------- updating

def worth_updating_for(text):
    """Would a newer yt-dlp plausibly fix this failure?

    A private, removed or members-only video will fail identically on every
    version ever released. Spending a minute on `brew upgrade` to prove that
    is worse than just saying so — so the auto-update only fires on failures
    that extraction breakage could actually explain.
    """
    lowered = (text or "").lower()
    hopeless = ("private", "unavailable", "removed", "members-only",
                "join this channel", "does not exist", "no space left",
                "not a valid url")
    return not any(word in lowered for word in hopeless)


def update_due():
    """True at most once a day, so the proactive check is nearly free."""
    try:
        with open(CHECK_STAMP) as fh:
            return (time.time() - float(fh.read().strip())) > CHECK_EVERY
    except (OSError, ValueError):
        return True  # never checked, or unreadable — check now


def stamp_check():
    try:
        os.makedirs(os.path.dirname(CHECK_STAMP), exist_ok=True)
        with open(CHECK_STAMP, "w") as fh:
            fh.write("%d" % time.time())
    except OSError:
        pass  # a lost stamp costs an extra check, nothing more


def auto_update(preamble=""):
    """Upgrade yt-dlp if it is genuinely behind. Returns the new version, or None.

    Locked, because two ytdl runs upgrading Homebrew at once is a good way to
    get a broken install out of a feature meant to prevent one.
    """
    installed, latest = behind_upstream()
    stamp_check()
    if not latest:
        return None

    try:
        lock = open(LOCKFILE, "w")
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (OSError, IOError):
        return None  # another run is already doing it

    try:
        say()
        say("%syt-dlp is %s and %s is out — updating." % (preamble, installed, latest))
        try:
            subprocess.run(["brew", "upgrade", "yt-dlp"],
                           capture_output=True, timeout=900)
        except (OSError, subprocess.TimeoutExpired):
            say("The update did not finish. Carrying on with %s." % installed)
            return None
        after = yt_dlp_version()
        if after and after != installed:
            say("Now on %s." % after)
            return after
        say("Homebrew has nothing newer than %s yet." % installed)
        return None
    finally:
        try:
            fcntl.flock(lock, fcntl.LOCK_UN)
            lock.close()
        except (OSError, IOError):
            pass


# ---------------------------------------------------------------- errors

def explain_failure(text, cookies_used, site=None):
    """Say the useful thing, not yt-dlp's error, whenever we recognise it.

    `site` keeps the wording honest: yt-dlp handles about 1,750 sites, and
    blaming YouTube for a Bandcamp failure is both wrong and confusing.
    """
    lowered = (text or "").lower()
    who = site or "the site"
    lines = []

    if "confirm you" in lowered or "not a bot" in lowered or "http error 403" in lowered:
        if cookies_used:
            lines.append("%s refused the download even with browser cookies." % who)
            lines.append("Try a different browser:  ytdl <url> --cookies safari")
        else:
            lines.append("%s wants a signed-in browser for this one." % who)
            lines.append("Try:  ytdl <url> --cookies")
    elif "no video formats" in lowered or "unsupported url" in lowered:
        lines.append("yt-dlp does not recognise that link.")
        lines.append("Check what is supported with:  ytdl --sites <name>")
    elif "private video" in lowered or "is private" in lowered:
        lines.append("That one is private.")
    elif "unavailable" in lowered or "removed" in lowered or "does not exist" in lowered:
        # Matched loosely on purpose: yt-dlp words this several ways ("video
        # unavailable", "This video is unavailable"), and an exact phrase match
        # silently drops back to dumping a raw traceback-ish error.
        lines.append("That is not available — removed, private, or blocked here.")
    elif "members-only" in lowered or "join this channel" in lowered:
        lines.append("That one is members-only.")
    elif "geo" in lowered and "restrict" in lowered:
        lines.append("That is blocked in this country.")
    elif "no space left" in lowered:
        lines.append("The disk is full.")
    else:
        lines.append("That failed.")
        tail = [ln for ln in (text or "").splitlines() if ln.strip()][-3:]
        lines += ["  " + ln.strip() for ln in tail]

    installed, latest = behind_upstream()
    if latest:
        lines.append("")
        lines.append("Also, this yt-dlp is %s and %s is out. YouTube breaks it often."
                     % (installed, latest))
        lines.append("Worth trying:  ytdl --update")
    return "\n".join(lines)


def notify(text, sound=SOUND_DONE):
    """Ping, and fall back to the default tone rather than losing the message.

    Pushover rejects the *entire* notification for an unknown sound name, so a
    tone that has not been uploaded yet would cost the ping, not just its
    sound. Retrying bare is cheaper than caching the sound list for something
    this infrequent.
    """
    if not os.path.exists(PUSHOVER):
        return
    base = [PUSHOVER, "send", text, "--title", "ytdl"]
    if sound == SOUND_FAIL:
        base += ["--priority", "1"]
    for cmd in ([base + ["--sound", sound]] if sound else []) + [base]:
        try:
            out = subprocess.run(cmd, capture_output=True, timeout=30)
            if out.returncode == 0:
                return
        except (OSError, subprocess.TimeoutExpired):
            return  # a failed ping must never look like a failed download


# ---------------------------------------------------------------- commands

def do_update():
    before = yt_dlp_version()
    say("Updating yt-dlp...")
    try:
        out = subprocess.run(["brew", "upgrade", "yt-dlp"],
                             capture_output=True, text=True, timeout=900)
    except (OSError, subprocess.TimeoutExpired):
        sys.exit("The update did not finish. Try it by hand:  brew upgrade yt-dlp")
    after = yt_dlp_version()
    if after and before and after != before:
        say("Updated from %s to %s." % (before, after))
    else:
        say("Already at %s." % (after or "an unknown version"))

    # Say whether that is genuinely current, so "already up to date" cannot be
    # mistaken for "Homebrew has stopped tracking it".
    latest = latest_release()
    if not latest:
        say("Could not check against yt-dlp's own releases just now.")
    elif after and after.lstrip("v") == latest.lstrip("v"):
        say("That is the current release — nothing newer exists.")
    else:
        say("Homebrew is behind: yt-dlp's current release is %s." % latest)
        say("For the newest build:  brew install --HEAD yt-dlp")


def playlist_items(url, cookies=None):
    """The entries in a playlist, flat and fast. [(n, title, duration)]."""
    cmd = [yt_dlp_path(), "--flat-playlist", "-J", "--no-warnings", "--yes-playlist"]
    if cookies:
        cmd += ["--cookies-from-browser", cookies]
    cmd.append(url)
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=1800)
        if out.returncode != 0:
            return [], (out.stderr or "").strip()
        data = json.loads(out.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError) as exc:
        return [], str(exc)
    rows = []
    for i, entry in enumerate(data.get("entries") or [], 1):
        if not entry:
            continue
        rows.append((i, entry.get("title") or "Untitled", entry.get("duration")))
    return rows, None


def do_list_items(url, cookies, plain):
    """Number every entry so you can say which ones you want.

    Printed rather than guessed at: --items takes numbers, and numbers are
    useless until you can see what they refer to.
    """
    rows, err = playlist_items(url, cookies)
    if err:
        sys.exit(explain_failure(err, bool(cookies), site_of(None, url)))
    if not rows:
        sys.exit("That link has no list behind it.")

    for number, title, seconds in rows:  # every one: no cap (Matthew, 2026-10-13)
        length = spoken_duration(seconds)
        if plain:
            # Tab separated, for the app to parse.
            say("%d\t%s%s" % (number, title, "\t%s" % length if length else ""))
        else:
            say("%3d. %s%s" % (number, title, "  (%s)" % length if length else ""))
    if not plain:
        say()
        say("%d item%s." % (len(rows), "" if len(rows) == 1 else "s"))
        say("Download some of them with:  ytdl <url> --playlist --items 1,3,5-8")


def do_sites(needle):
    """Answer "will this work on X?" without making him try it and find out.

    yt-dlp handles roughly 1,750 sites, not just YouTube. The list is far too
    long to read aloud, so this searches it.
    """
    out = subprocess.run([yt_dlp_path(), "--list-extractors"],
                         capture_output=True, text=True, timeout=120)
    names = [n.strip() for n in (out.stdout or "").splitlines() if n.strip()]
    if not names:
        say("Could not read the list of supported sites.")
        return

    if not needle:
        say("yt-dlp supports %d sites." % len(names))
        say("Check one with:  ytdl --sites bandcamp")
        say()
        say("Anything it does not recognise still gets a generic attempt, "
            "which works on plain media links.")
        return

    hits = [n for n in names if needle.lower() in n.lower()]
    if not hits:
        say("Nothing matching \"%s\" in the %d supported sites." % (needle, len(names)))
        say("It may still work — yt-dlp falls back to a generic attempt on any "
            "link with media on it.")
        return
    say("%d match%s for \"%s\":" % (len(hits), "" if len(hits) == 1 else "es", needle))
    for name in hits[:30]:
        say("  %s" % name)
    if len(hits) > 30:
        say("  ...and %d more" % (len(hits) - 30))


def describe(info):
    """The two lines said before every download: what it is, and how big."""
    title = info.get("title") or "Untitled"
    uploader = info.get("uploader") or info.get("channel")

    if info.get("_type") == "playlist" or info.get("entries") is not None:
        count = info.get("playlist_count") or len(info.get("entries") or [])
        say("Playlist: %s%s" % (title, " — %s" % uploader if uploader else ""))
        say("%d video%s." % (count, "" if count == 1 else "s"))
        return title

    say("%s%s" % (title, " — %s" % uploader if uploader else ""))

    bits = []
    length = spoken_duration(info.get("duration"))
    if length:
        bits.append(length)
    size = spoken_size(info.get("filesize_approx") or info.get("filesize"))
    if size:
        bits.append("about %s" % size)
    if bits:
        say(". ".join(bits) + ".")
    return title


def do_info(info):
    describe(info)
    when = info.get("upload_date")
    if when and len(when) == 8:
        say("Uploaded %s-%s-%s." % (when[0:4], when[4:6], when[6:8]))

    # What yt-dlp itself selected, not our own guess at its ranking. It sorts
    # on codec efficiency before raw bitrate, so Opus at 106k beats AAC at
    # 130k — re-implementing that here would describe the wrong stream.
    streams = info.get("requested_formats") or [info]
    for stream in streams:
        acodec = stream.get("acodec")
        vcodec = stream.get("vcodec")
        if vcodec and vcodec != "none":
            say("Video: %s, %sp." % (vcodec, stream.get("height") or "?"))
        if acodec and acodec != "none":
            abr = stream.get("abr")
            say("Audio: %s%s." % (acodec, ", %d kbps" % round(abr) if abr else ""))
    say()
    say("That is what would be downloaded. Nothing was — that was --info.")


def build_command(args, url):
    cmd = [yt_dlp_path(),
           "-P", "home:%s" % args.to,
           "-P", "temp:%s" % SCRATCH,
           "--trim-filenames", "180",
           "--no-warnings",
           "--print", "after_move:%s%%(filepath)s" % MARK]

    if args.name:
        cmd += ["-o", "%s.%%(ext)s" % args.name]
    elif args.playlist:
        # Its own folder, numbered in playlist order, so the set stays together
        # and sorts correctly by name.
        cmd += ["-o", "%(playlist_title)s/%(playlist_index)03d - %(title)s.%(ext)s"]
    else:
        cmd += ["-o", "%(title)s.%(ext)s"]

    if args.playlist:
        cmd.append("--yes-playlist")
        # Announce each item as it starts, so a 40-track playlist is a spoken
        # running commentary rather than twenty minutes of silence.
        # autonumber, not playlist_index: with --items 2,4 the index is the
        # position in the whole list while n_entries is how many you picked,
        # so the fraction read "4/2". autonumber counts what is actually being
        # downloaded, which is what a progress line is for.
        cmd += ["--print", "before_dl:%s%%(playlist_autonumber)s of "
                           "%%(n_entries)s: %%(title)s" % ITEM]
        # One item failing must not abandon the rest of the list.
        cmd.append("--ignore-errors")
        if args.items:
            cmd += ["--playlist-items", args.items]
        if args.resume:
            cmd += ["--download-archive",
                    os.path.join(args.to, ARCHIVE_NAME)]
    else:
        cmd.append("--no-playlist")

    cmd += selector(args)

    # An exact stream, asked for by id or chosen from --pick, is taken as it
    # comes. Applying a saved default format here would re-encode the very
    # stream you went to the trouble of naming — which is how --format-id 251
    # (Opus) once landed as a fatter, lossier .m4a.
    if args.format_id and not args.explicit_kind:
        if getattr(args, "format_audio_only", False):
            # Container swap only — "best" keeps the source codec, so this
            # turns raw .webm into .opus without touching the audio.
            cmd += ["-x", "--audio-format", "best", "--embed-metadata"]
        else:
            cmd += ["--merge-output-format", "mp4", "--embed-metadata"]
    elif args.kind == "video":
        cmd += ["--merge-output-format", "mp4"]
    elif args.kind == "mp3":
        cmd += ["-x", "--audio-format", "mp3", "--audio-quality", "320K",
                "--embed-metadata"]
    elif args.kind == "wav":
        cmd += ["-x", "--audio-format", "wav"]
    elif args.kind == "flac":
        cmd += ["-x", "--audio-format", "flac", "--embed-metadata"]
    elif args.kind in ("m4a", "opus"):
        cmd += ["-x", "--audio-format", args.kind, "--embed-metadata"]
    elif not args.format_id:
        # "best" means keep the source codec — container change only.
        cmd += ["-x", "--audio-format", "best", "--embed-metadata"]

    # A time range. --force-keyframes-at-cuts costs a re-encode of the cut
    # itself but makes the start land where you asked rather than at the
    # nearest keyframe, which can be seconds early.
    start, end = parse_time(args.start), parse_time(args.end)
    if start is not None or end is not None:
        cmd += ["--download-sections",
                "*%s-%s" % (clock(start or 0), clock(end) if end is not None else "inf"),
                "--force-keyframes-at-cuts"]

    if args.chapters:
        cmd.append("--split-chapters")

    if args.subtitles:
        # "en.*" looks right and is a trap: it matches every auto-*translated*
        # track YouTube offers (en-de, en-fr, ...), which is dozens of requests
        # and earns an HTTP 429 rather than a subtitle file. Name the real
        # English tracks instead.
        #
        # -i as well, because subtitles are a bonus and a bonus must never cost
        # the download itself — without it a failed subtitle fetch aborts the
        # whole run and you get no media at all.
        cmd += ["--write-auto-subs", "--write-subs",
                "--sub-langs", "en,en-orig,en-US,en-GB",
                "--convert-subs", "srt", "-i"]

    if args.cookies:
        cmd += ["--cookies-from-browser", args.cookies]

    if args.progress:
        cmd += ["--newline", "--progress-template",
                "download:PROGRESS %(progress._percent_str)s %(progress._eta_str)s"]
    else:
        cmd.append("--no-progress")

    if args.passthrough:
        # Last, so a raw flag can override anything this wrapper decided.
        import shlex
        cmd += shlex.split(args.passthrough)

    cmd.append(url)
    return cmd


def run_download(cmd, args):
    import time

    files, tail = [], []
    last_spoken = 0.0
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, text=True, bufsize=1)
    except OSError as exc:
        sys.exit("Could not start yt-dlp: %s" % exc)

    try:
        for line in proc.stdout:
            line = line.rstrip()
            if not line:
                continue
            if line.startswith(MARK):
                files.append(line[len(MARK):])
                continue
            if line.startswith(ITEM):
                # Reset the progress clock per item, so the first percentage
                # of a new track is not swallowed by the previous one's.
                last_spoken = 0.0
                say(line[len(ITEM):])
                continue
            tail.append(line)
            del tail[:-40]
            if line.startswith("PROGRESS "):
                now = time.time()
                if now - last_spoken >= PROGRESS_EVERY:
                    last_spoken = now
                    parts = line.split()
                    pct = parts[1] if len(parts) > 1 else "?"
                    eta = parts[2] if len(parts) > 2 else ""
                    say("  %s%s" % (pct.strip(),
                                    ", %s left" % eta if eta and eta != "NA" else ""))
                    job_write("downloading", percent=pct.strip())
            elif "has already been downloaded" in line:
                say("Already downloaded — leaving the existing file alone.")
    except KeyboardInterrupt:
        proc.terminate()
        say()
        say("Stopped. Nothing was left behind.")
        return 130, files, tail
    finally:
        proc.stdout.close()
    return proc.wait(), files, tail


# ---------------------------------------------------------------- main

def download_one(args, url):
    """One link, start to finish. Returns a one-word outcome.

    Returns rather than exits, because with several links a failure on
    one must not abandon the rest — the same rule playlists already
    follow.
    """
    info, error = fetch_info(url, args.cookies, selector(args), flat=args.playlist)
    if info is None:
        # Private, unavailable, or a bot check — this is the *common* failure,
        # and it lands before the download, so it needs the ping just as much.
        if args.notify:
            notify("Download failed: %s" % url[:120], SOUND_FAIL)
        say(explain_failure(error, bool(args.cookies), site_of(None, url)))
        job_write("failed", title=url[:90])
        return "failed"

    job_write("downloading", title=(info.get("title") or "")[:90], percent="")

    if args.info:
        do_info(info)
        return "info"

    if (args.pick or args.list_formats) and args.playlist:
        # A flat playlist listing carries no per-video formats, and the videos
        # in one list rarely offer the same set anyway.
        say("--pick and --list-formats work on a single item, not a set.")
        say("Use --format or --max-height for a whole list.")
        return "skipped"

    if args.pick or args.list_formats:
        describe(info)
        say()
        chosen = do_list_formats(info, interactive=args.pick)
        if not chosen:
            return "skipped"
        args.format_id = chosen
        say()

    # Is the named stream audio-only? Decides whether it gets remuxed to an
    # audio container or merged as video. "id+bestaudio" from --pick is always
    # a video pairing.
    args.format_audio_only = False
    if args.format_id and "+" not in args.format_id:
        for fmt in info.get("formats") or []:
            if str(fmt.get("format_id")) == str(args.format_id):
                vcodec = fmt.get("vcodec")
                args.format_audio_only = not (vcodec and vcodec != "none")
                break

    if not args.quiet:
        if not (args.pick or args.list_formats):
            describe(info)
        if in_a_playlist(url, info) and not args.playlist:
            count = playlist_size(url)
            say("That link is part of a set%s — taking just this one." %
                (" of %d items" % count if count else ""))
            say("Add --playlist for the whole thing.")
        start, end = parse_time(args.start), parse_time(args.end)
        if start is not None or end is not None:
            say("Just the section from %s to %s."
                % (spoken_duration(start) or "the start",
                   spoken_duration(end) or "the end"))
        if args.playlist:
            say("Downloading the playlist%s%s..."
                % (" (items %s)" % args.items if args.items else "",
                   ", skipping any already fetched" if args.resume else ""))
        else:
            say("Downloading...")

    os.makedirs(args.to, exist_ok=True)
    os.makedirs(SCRATCH, exist_ok=True)

    code, files, tail = run_download(build_command(args, url), args)

    if code == 130:
        return "stopped"

    partial = False
    if code != 0:
        text = "\n".join(tail)

        # A playlist that got part of the way is a partial success, not a
        # failure. --ignore-errors keeps yt-dlp going past a bad item and it
        # still exits non-zero, so treating that as total failure would throw
        # away news of every file that *did* arrive — and re-running would be
        # the only way to find out. Report both instead.
        if args.playlist and files:
            partial = True
        else:
            # Otherwise a failure is the moment a newer yt-dlp is actually
            # worth having, so this is where the auto-update earns its keep —
            # not on a timer. It only fires for failures an upgrade could
            # plausibly fix, and only retries when the version genuinely moved.
            if args.auto_update and worth_updating_for(text):
                if auto_update("That failed. "):
                    say("Trying again...")
                    code, files, tail = run_download(build_command(args, url), args)
                    text = "\n".join(tail)
            if code != 0:
                # Silence is the worst outcome for a download started from the
                # phone, so failure pings too — at priority 1, unlike a finish.
                if args.notify:
                    notify("Download failed: %s"
                           % (info.get("title") or url)[:120], SOUND_FAIL)
                say(explain_failure(text, bool(args.cookies),
                                    site_of(info, url)))
                job_write("failed", title=(info.get("title") or url)[:90])
                return "failed"

    # Leave no fragments behind — the whole point of the split paths.
    try:
        for leftover in os.listdir(SCRATCH):
            path = os.path.join(SCRATCH, leftover)
            if os.path.isdir(path):
                shutil.rmtree(path, ignore_errors=True)
            else:
                os.remove(path)
    except OSError:
        pass

    if not files:
        # For a resumed playlist this is the normal, happy outcome, not a
        # mystery — say so plainly rather than falling back to a shrug.
        if args.playlist and args.resume:
            say()
            say("Nothing new — everything in that range was already downloaded.")
            say("Use --no-resume to fetch them again.")
        else:
            say("Finished, but yt-dlp did not report a filename. Check %s" % args.to)
        return "nothing"

    if args.quiet:
        for path in files:
            say(path)
        return "ok"

    say()
    if len(files) == 1:
        name = os.path.basename(files[0])
        size = spoken_size(os.path.getsize(files[0])) if os.path.exists(files[0]) else None
        say("Done. Saved to %s as %s%s" %
            (os.path.basename(args.to), name, " (%s)" % size if size else ""))
    else:
        say("Done. %d files saved to %s" % (len(files), os.path.basename(args.to)))

    if partial:
        say()
        say("Some items in the playlist did not download.")
        say(explain_failure("\n".join(tail), bool(args.cookies),
                            site_of(info, url)))
        if args.resume:
            say()
            say("Re-run the same command to retry just the missing ones.")

    if args.notify:
        if partial:
            notify("Playlist partly done: %d file(s), some items failed"
                   % len(files), SOUND_FAIL)
        else:
            notify("Downloaded %s" % (os.path.basename(files[0]) if len(files) == 1
                                      else "%d files" % len(files)))

    job_write("partial" if partial else "done",
              title=(info.get("title") or "")[:90], percent="")
    return "partial" if partial else "ok"


def main():
    ap = argparse.ArgumentParser(add_help=True, description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("urls", nargs="*", metavar="URL",
                    help="one or more links (default: the clipboard)")
    ap.add_argument("--to", help="destination folder")
    ap.add_argument("--name", help="filename, without extension")

    fmt = ap.add_argument_group("what to download")
    fmt.add_argument("--format", dest="kind", choices=FORMATS,
                     help="best, m4a, opus, mp3, wav, flac or video")
    fmt.add_argument("--video", dest="kind", action="store_const", const="video",
                     help="same as --format video")
    fmt.add_argument("--mp3", dest="kind", action="store_const", const="mp3",
                     help="same as --format mp3")
    fmt.add_argument("--wav", dest="kind", action="store_const", const="wav",
                     help="same as --format wav")
    fmt.add_argument("--max-height", type=int, metavar="N",
                     help="cap video height, e.g. 720")
    fmt.add_argument("--pick", action="store_true",
                     help="list the real formats and choose one by number")
    fmt.add_argument("--list-formats", action="store_true",
                     help="list the real formats, download nothing")
    fmt.add_argument("--format-id", help="an exact yt-dlp format id")

    part = ap.add_argument_group("part of a video")
    part.add_argument("--from", dest="start", metavar="TIME",
                      help="start at 1:30, 90 or 1:02:03")
    part.add_argument("--to-time", dest="end", metavar="TIME", help="stop at")
    part.add_argument("--chapters", action="store_true",
                      help="also split into one file per chapter")
    part.add_argument("--subtitles", action="store_true",
                      help="also fetch English subtitles as .srt")

    pl = ap.add_argument_group("playlists")
    pl.add_argument("--playlist", action="store_true",
                    help="take the whole playlist, into its own folder")
    pl.add_argument("--items", metavar="RANGE",
                    help="which ones: 1-10, or 3,5,7")
    pl.add_argument("--no-resume", dest="resume", action="store_false",
                    help="re-download playlist items already fetched")

    ap.add_argument("--info", action="store_true", help="describe it, download nothing")
    ap.add_argument("--progress", dest="progress", action="store_const", const=True,
                    default=None, help="a percentage every 10s")
    ap.add_argument("--no-progress", dest="progress", action="store_const",
                    const=False, help="stay quiet during the download")
    ap.add_argument("--no-auto-update", dest="auto_update", action="store_const",
                    const=False, default=None,
                    help="never upgrade yt-dlp on its own")
    ap.add_argument("--cookies", nargs="?", const="chrome", metavar="BROWSER",
                    help="use sign-in cookies from a browser (default chrome)")
    ap.add_argument("--notify", dest="notify", action="store_const", const=True,
                    default=None, help="Pushover ping when done")
    ap.add_argument("--no-notify", dest="notify", action="store_const",
                    const=False, help="no ping, even if saved on")
    ap.add_argument("--quiet", action="store_true", help="print only the final path")
    ap.add_argument("--update", action="store_true", help="brew upgrade yt-dlp")
    ap.add_argument("--set-default", metavar="FORMAT",
                    help="remember a format as your default (with --to, a folder)")
    ap.add_argument("--settings", action="store_true", help="show your saved defaults")
    ap.add_argument("--sites", nargs="?", const="", metavar="NAME",
                    help="is a site supported? e.g. --sites bandcamp")
    ap.add_argument("--setup", action="store_true",
                    help="walk through every setting, one question at a time")
    ap.add_argument("--set", dest="set_pairs", action="append", metavar="KEY=VALUE",
                    help="set one setting without the questions, e.g. --set notify=yes")
    ap.add_argument("--batch", metavar="FILE",
                    help="a file of links, one per line")
    # Needs = rather than a space: a value starting with a dash looks like a
    # flag to argparse, and --yt-dlp "--write-thumbnail" would fail.
    ap.add_argument("--yt-dlp", dest="passthrough", metavar="ARGS",
                    help='raw arguments straight to yt-dlp, for anything this '
                         'wrapper does not cover. Needs an equals sign: '
                         '--yt-dlp="--write-thumbnail"')
    ap.add_argument("--yt-dlp-help", action="store_true",
                    help="yt-dlp's own full option list")
    ap.add_argument("--jobs", action="store_true",
                    help="what is downloading now, and what finished recently")
    ap.add_argument("--get", nargs="?", const="", metavar="KEY",
                    help="print settings as key=value, for scripts and the app")
    ap.add_argument("--list-items", metavar="URL",
                    help="number every item in a playlist, so you can choose")
    ap.add_argument("--plain", action="store_true",
                    help="tab-separated output, for scripts and the app")
    ap.add_argument("--check-url", metavar="URL",
                    help="does yt-dlp recognise this link? prints the site name, "
                         "exits non-zero if not. Offline and instant.")
    for i, raw in enumerate(sys.argv[1:]):
        if raw == "--yt-dlp":
            sys.exit('--yt-dlp needs an equals sign, because its value starts '
                     'with a dash:\n  ytdl <url> --yt-dlp="--write-thumbnail"')
    args = ap.parse_args()

    if args.update:
        do_update()
        return

    if args.sites is not None:
        do_sites(args.sites)
        return

    if args.get is not None:
        cfg_now = load_config()
        values = {"to": setting(cfg_now, "to", DEST),
                  "format": setting(cfg_now, "format", "best"),
                  "notify": yes_no(setting(cfg_now, "notify", False)),
                  "progress": yes_no(setting(cfg_now, "progress", False)),
                  "auto_update": yes_no(setting(cfg_now, "auto_update", True)),
                  "cookies": setting(cfg_now, "cookies", None) or "no",
                  "max_height": (setting(cfg_now, "max_height", None) or "none")}
        if args.get:
            if args.get not in values:
                sys.exit("Not a setting: %s" % args.get)
            say(str(values[args.get]))
        else:
            for key, _ in SETTINGS:
                say("%s=%s" % (key, values[key]))
        return

    if args.list_items:
        do_list_items(args.list_items, args.cookies, args.plain)
        return

    if args.check_url:
        do_check_url(args.check_url)
        return

    if args.jobs:
        do_jobs()
        return

    if args.yt_dlp_help:
        # Every yt-dlp option, unfiltered. Wrapping ~200 flags individually
        # would make --help unreadable by ear, which is the problem this tool
        # exists to solve — so the full list stays one command away and
        # --yt-dlp passes anything from it straight through.
        say("Every yt-dlp option. Pass any of them with:  ytdl <url> "
            "--yt-dlp \"--flag value\"")
        say()
        out = subprocess.run([yt_dlp_path(), "--help"], capture_output=True,
                             text=True, timeout=60)
        say(out.stdout)
        return

    if args.setup:
        do_setup()
        return

    if args.set_pairs:
        do_set_pairs(args.set_pairs)
        return

    cfg = load_config()

    if args.set_default or (args.to and args.settings):
        do_set_default(args.set_default, args.to)
        return

    if args.settings:
        show_settings(cfg)
        return

    # Your saved defaults, with an explicit flag always winning over them.
    # Remember which it was: a saved default must not silently transcode a
    # stream you asked for by id.
    args.explicit_kind = args.kind is not None
    if args.kind is None:
        args.kind = cfg.get("format", "best")
    if args.to is None:
        args.to = setting(cfg, "to", DEST)
    if args.notify is None:
        args.notify = setting(cfg, "notify", False)
    if args.progress is None:
        args.progress = setting(cfg, "progress", False)
    if args.auto_update is None:
        args.auto_update = setting(cfg, "auto_update", True)
    if args.cookies is None:
        args.cookies = setting(cfg, "cookies", None)
    if args.max_height is None:
        args.max_height = setting(cfg, "max_height", None)

    for label, value in (("--from", args.start), ("--to-time", args.end)):
        if value is not None and parse_time(value) is None:
            sys.exit("%s does not look like a time: %s\n"
                     "Use 90, 1:30 or 1:02:03." % (label, value))
    if (parse_time(args.start) is not None and parse_time(args.end) is not None
            and parse_time(args.end) <= parse_time(args.start)):
        sys.exit("--to-time has to come after --from.")

    urls = [check_url(u) for u in args.urls]
    if args.batch:
        try:
            with open(os.path.expanduser(args.batch)) as fh:
                for line in fh:
                    line = line.strip()
                    if line and not line.startswith("#"):
                        urls.append(check_url(line))
        except OSError as exc:
            sys.exit("Could not read %s: %s" % (args.batch, exc))
    if not urls:
        urls = [check_url(url_from_clipboard())]
    args.to = os.path.abspath(os.path.expanduser(args.to))

    if not args.urls and not args.batch and not args.quiet:
        say("Using the URL on the clipboard.")
    if len(urls) > 1 and args.name:
        sys.exit("--name sets one filename, so it only works with one link.")

    job_start(urls)
    outcomes = []
    for i, one in enumerate(urls, 1):
        if len(urls) > 1 and not args.quiet:
            say()
            say("--- %d of %d ---" % (i, len(urls)))
        job_write("downloading", done=i - 1, percent="")
        outcomes.append(download_one(args, one))
        # A named format id or a --pick choice belongs to the link it was
        # chosen for, and must not leak onto the next one.
        args.format_id = None

    if len(urls) > 1 and not args.quiet:
        good = outcomes.count("ok") + outcomes.count("partial")
        bad = outcomes.count("failed")
        say()
        say("All done. %d of %d succeeded%s."
            % (good, len(urls), ", %d failed" % bad if bad else ""))
        job_write("failed" if good == 0 else ("partial" if bad else "done"),
                  title="%d of %d links" % (good, len(urls)), percent="")
        if args.notify:
            notify("Batch finished: %d of %d succeeded" % (good, len(urls)),
                   SOUND_FAIL if bad else SOUND_DONE)


    # The proactive half, once a day, and deliberately *after* the download —
    # so the common case is that the upgrade already happened by the time a
    # break would have hit you, and the rare case is a minute of brew you were
    # not waiting on anyway. Never before: nothing should stand between you
    # and the file you asked for.
    if args.auto_update and update_due():
        auto_update()

    # Mentioned once, ever, and only *after* a download has already worked —
    # a setup prompt standing between someone and their first file is the
    # fastest way to make a tool feel like homework.
    if not os.path.exists(CONFIG) and not args.quiet:
        say()
        say("First time? `ytdl --setup` sets where downloads go and what "
            "format you want, so you stop typing flags.")
        save_config({})


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        say()
        sys.exit(130)
