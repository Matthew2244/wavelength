def show_settings(cfg):
    say("Your settings")
    say()
    say("  Downloads go to:      %s" % pretty_path(setting(cfg, "to", DEST)))
    say("  Default format:       %s" % setting(cfg, "format", "best"))
    say("  Ping when finished:   %s" % yes_no(setting(cfg, "notify", False)))
    say("  Say progress:         %s" % yes_no(setting(cfg, "progress", False)))
    say("  Auto-update yt-dlp:   %s" % yes_no(setting(cfg, "auto_update", True)))
    cookies = setting(cfg, "cookies", None)
    say("  Browser cookies:      %s" % (cookies or "no"))
    cap = setting(cfg, "max_height", None)
    say("  Cap video height:     %s" % ("%dp" % cap if cap else "no cap"))
    say()
    say("Change them with:  ytdl --setup")
    say("Settings file:     %s" % pretty_path(CONFIG))
    if not os.path.exists(CONFIG):
        say()
        say("(Nothing saved yet — those are the built-in defaults.)")


def ask(prompt, options, current_label):
    """One question, numbered options, Enter keeps what is already set.

    Returns the chosen value, or the sentinel KEEP.
    """
    say()
    say(prompt)
    say("  Currently: %s" % current_label)
    for i, (label, _) in enumerate(options, 1):
        say("  %d. %s" % (i, label))
    try:
        answer = input("  Number, or Enter to keep it: ").strip()
    except (EOFError, KeyboardInterrupt):
        raise KeyboardInterrupt
    if not answer:
        return KEEP
    if not answer.isdigit() or not 1 <= int(answer) <= len(options):
        say("  Not one of the numbers — keeping what you had.")
        return KEEP
    return options[int(answer) - 1][1]


KEEP = object()


def ask_path():
    try:
        raw = input("  Full path to the folder: ").strip()
    except (EOFError, KeyboardInterrupt):
        raise KeyboardInterrupt
    if not raw:
        return KEEP
    path = os.path.abspath(os.path.expanduser(raw))
    parent = os.path.dirname(path)
    if not os.path.isdir(path) and not os.path.isdir(parent):
        say("  There is no folder at %s, and its parent does not exist either."
            % pretty_path(path))
        say("  Keeping what you had.")
        return KEEP
    return path


def do_setup():
    """Walk through every setting, one question at a time."""
    if not sys.stdin.isatty():
        sys.exit("ytdl --setup asks questions, so it needs a terminal.\n"
                 "Use `ytdl --settings` to see what is set, or "
                 "`ytdl --set-default <format>` to change one thing.")

    cfg = load_config()
    first = not os.path.exists(CONFIG)

    say("ytdl settings" + (" — first run" if first else ""))
    say()
    say("Seven questions. Press Enter on any of them to keep what is already "
        "set, or Control-C to stop without saving.")

    icloud = os.path.join(HOME, "Library", "Mobile Documents", "com~apple~CloudDocs")
    try:
        choice = ask("1 of 7. Where should downloads go?",
                     [("Downloads, in Media Downloads (on this computer)",
                       os.path.join(HOME, "Downloads", "Media Downloads")),
                      ("iCloud Drive, in Media Downloads (on all your devices)",
                       os.path.join(icloud, "Media Downloads")),
                      ("Your Downloads folder itself", os.path.join(HOME, "Downloads")),
                      ("Your Music folder", os.path.join(HOME, "Music")),
                      ("Somewhere else — type the path", "ASK")],
                     pretty_path(setting(cfg, "to", DEST)))
        if choice == "ASK":
            choice = ask_path()
        if choice is not KEEP:
            cfg["to"] = choice

        choice = ask("2 of 7. What format by default?",
                     [("best — never converts, keeps the source codec", "best"),
                      ("m4a — plays anywhere, converts non-AAC sources", "m4a"),
                      ("opus — smallest, converts non-Opus sources", "opus"),
                      ("mp3 — most compatible, always converts", "mp3"),
                      ("wav — uncompressed, for a DAW session", "wav"),
                      ("flac — lossless", "flac"),
                      ("video — MP4 with picture", "video")],
                     setting(cfg, "format", "best"))
        if choice is not KEEP:
            cfg["format"] = choice

        choice = ask("3 of 7. Ping your phone when a download finishes?",
                     [("Yes, always", True), ("No — only when I pass --notify", False)],
                     yes_no(setting(cfg, "notify", False)))
        if choice is not KEEP:
            cfg["notify"] = choice

        choice = ask("4 of 7. Say a percentage while downloading?",
                     [("Yes, every 10 seconds", True),
                      ("No — just say when it is done", False)],
                     yes_no(setting(cfg, "progress", False)))
        if choice is not KEEP:
            cfg["progress"] = choice

        choice = ask("5 of 7. Keep yt-dlp up to date by itself?",
                     [("Yes — recommended, sites break it often", True),
                      ("No, I will run ytdl --update myself", False)],
                     yes_no(setting(cfg, "auto_update", True)))
        if choice is not KEEP:
            cfg["auto_update"] = choice

        cookies = setting(cfg, "cookies", None)
        choice = ask("6 of 7. Use browser sign-in cookies by default?\n"
                     "  Only needed for sites that ask you to prove you are "
                     "not a bot.",
                     [("No — ask for them with --cookies when needed", ""),
                      ("Chrome", "chrome"), ("Safari", "safari"),
                      ("Firefox", "firefox"), ("Edge", "edge")],
                     cookies or "no")
        if choice is not KEEP:
            cfg["cookies"] = choice or None

        cap = setting(cfg, "max_height", None)
        choice = ask("7 of 7. Cap video height?\n"
                     "  Smaller files, and it only affects --video.",
                     [("No cap — best available", 0), ("1080p", 1080),
                      ("720p", 720), ("480p", 480)],
                     "%dp" % cap if cap else "no cap")
        if choice is not KEEP:
            cfg["max_height"] = choice or None

    except KeyboardInterrupt:
        say()
        say()
        say("Stopped. Nothing was changed.")
        return

    say()
    if save_config(cfg):
        say("Saved.")
        say()
        show_settings(load_config())
        say()
        say("A flag always beats a saved setting, so none of this locks you in.")


# ---------------------------------------------------------------- time ranges

def parse_time(text):
    """Accept 90, 1:30 or 1:02:03 and return seconds. None if unparseable."""
    if text is None:
        return None
    text = str(text).strip()
    if not re.match(r"^\d+(:\d{1,2}){0,2}$", text):
        return None
    parts = [int(p) for p in text.split(":")]
    seconds = 0
    for part in parts:
        seconds = seconds * 60 + part
    return seconds


def clock(seconds):
    """Seconds back to h:mm:ss, for handing to yt-dlp."""
    hours, rest = divmod(int(seconds), 3600)
    minutes, secs = divmod(rest, 60)
    return "%d:%02d:%02d" % (hours, minutes, secs)


# ---------------------------------------------------------------- yt-dlp

def yt_dlp_python():
    """The interpreter yt-dlp runs on, read from its own shebang.

    Homebrew installs yt-dlp into a versioned virtualenv, so hardcoding the
    path would break on the next upgrade. The shebang always points at the
    right one.
    """
    try:
        with open(yt_dlp_path()) as fh:
            first = fh.readline().strip()
        if first.startswith("#!") and os.path.exists(first[2:].split()[0]):
            return first[2:].split()[0]
    except (OSError, IndexError):
        pass
    return None


CHECK_SNIPPET = """
import sys
from yt_dlp.extractor import gen_extractor_classes
url = sys.argv[1]
for ie in gen_extractor_classes():
    name = ie.IE_NAME
    if name.lower().startswith('generic'):
        continue
    try:
        if ie.suitable(url):
            print(name)
            break
    except Exception:
        pass
"""


def recognised_by(url):
    """Which yt-dlp extractor claims this URL, ignoring the generic catch-all.

    Asks yt-dlp's own matchers rather than guessing from the hostname, and does
    it entirely offline — no request is made, so this is fast enough to run
    before a dialog opens. The generic extractor is skipped on purpose: it
    matches literally any http link, so counting it would mean "recognised"
    told you nothing.
    """
    interpreter = yt_dlp_python()
    if not interpreter:
        return None
    try:
        out = subprocess.run([interpreter, "-c", CHECK_SNIPPET, url],
                             capture_output=True, text=True, timeout=30)
        return (out.stdout or "").strip() or None
    except (OSError, subprocess.TimeoutExpired):
        return None


def do_check_url(url):
    """Would yt-dlp know what to do with this? Exit 0 if yes."""
    if not url:
        sys.exit(1)
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in ("http", "https") or not parsed.netloc:
        sys.exit(1)
    name = recognised_by(url)
    if name:
        say(name)
        return
    # A direct link to a media file is worth accepting even with no extractor
    # behind it — the generic path handles those perfectly well.
    if re.search(r"\.(mp3|mp4|m4a|opus|ogg|wav|flac|webm|mkv|mov|aac|m3u8)(\?|$)",
                 parsed.path, re.I):
        say("direct media file")
        return
    sys.exit(1)


def job_write(state, **fields):
    """Record what this run is doing. Never allowed to break a download."""
    path = os.environ.get("YTDL_JOB_FILE")
    if not path:
        return
    try:
        data = {}
        if os.path.exists(path):
            with open(path) as fh:
                data = json.load(fh)
        data.update(fields)
        data["state"] = state
        data["updated"] = time.time()
        with open(path, "w") as fh:
            json.dump(data, fh)
    except (OSError, ValueError):
        pass


def job_start(urls):
    """Claim a job file for this run, and sweep away stale ones."""
    try:
        os.makedirs(JOBS, exist_ok=True)
        now = time.time()
        for name in os.listdir(JOBS):
            full = os.path.join(JOBS, name)
            try:
                if now - os.path.getmtime(full) > JOB_KEEP:
                    os.remove(full)
            except OSError:
                pass
        os.environ["YTDL_JOB_FILE"] = os.path.join(JOBS, "%d.json" % os.getpid())
        job_write("starting", total=len(urls), done=0, title="", percent="")
    except OSError:
        pass


def do_jobs():
    """What is downloading right now, and what finished recently."""
    try:
        names = sorted(os.listdir(JOBS))
    except OSError:
        names = []
    rows = []
    for name in names:
        try:
            with open(os.path.join(JOBS, name)) as fh:
                data = json.load(fh)
        except (OSError, ValueError):
            continue
        pid = name.split(".")[0]
        alive = False
        if pid.isdigit():
            try:
                os.kill(int(pid), 0)
                alive = True
            except OSError:
                alive = False
        # A job whose process is gone but which never reported an ending was
        # killed. Saying "downloading" forever would be a lie.
        state = data.get("state", "?")
        if not alive and state in ("starting", "downloading"):
            state = "stopped"
        rows.append((data.get("updated", 0), state, data, alive))

    if not rows:
        say("Nothing downloading, and nothing finished recently.")
        return
    rows.sort(key=lambda r: r[0], reverse=True)
    running = [r for r in rows if r[3]]
    finished = [r for r in rows if not r[3]]

    if running:
        say("Downloading now:")
        for _, state, data, _ in running:
            bits = [data.get("title") or "(reading the link)"]
            if (data.get("total") or 1) > 1:
                bits.append("%d of %d" % ((data.get("done") or 0) + 1, data["total"]))
            if data.get("percent"):
                bits.append(data["percent"])
            say("  %s" % " - ".join(bits))
    else:
        say("Nothing downloading right now.")

    if finished:
        say()
        say("Recently:")
        for _, state, data, _ in finished[:8]:
            word = {"done": "finished", "failed": "FAILED",
                    "partial": "partly done", "stopped": "stopped"}.get(state, state)
            ago = spoken_duration(time.time() - (data.get("updated") or 0)) or "moments"
            say("  %-11s %s  (%s ago)"
                % (word, (data.get("title") or "?")[:52], ago))


def yt_dlp_path():
    path = shutil.which("yt-dlp")
    if not path:
        sys.exit("yt-dlp is not installed. Install it with:  brew install yt-dlp")
    return path


def yt_dlp_version():
    try:
        out = subprocess.run([yt_dlp_path(), "--version"], capture_output=True,
                             text=True, timeout=30)
        return out.stdout.strip() or None
    except (OSError, subprocess.TimeoutExpired):
        return None


def latest_release():
    """The newest yt-dlp release, or None if we could not find out.

    Silent on failure, deliberately: "could not check" and "you are behind"
    must never look the same. This replaced an age-in-days heuristic, which
    called a perfectly current install stale simply because yt-dlp had not
    released in a while — a warning that fires on every failure and points at
    a fix that does nothing is how you teach someone to ignore it.
    """
    try:
        req = urllib.request.Request(
            RELEASES, headers={"Accept": "application/vnd.github+json",
                               "User-Agent": "ytdl"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.load(resp).get("tag_name") or None
    except Exception:
        return None


def behind_upstream():
    """(installed, latest) only when genuinely behind. (None, None) otherwise."""
    installed = yt_dlp_version()
    latest = latest_release()
    if installed and latest and installed.lstrip("v") != latest.lstrip("v"):
        return installed, latest
    return None, None


